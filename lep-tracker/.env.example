# Postgres connection string (Supabase gives you this).
# For Supabase use the "Connection Pooling" (port 6543) string for the app,
# and the direct (port 5432) string for migrations.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# A long random secret used to sign login sessions.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"
